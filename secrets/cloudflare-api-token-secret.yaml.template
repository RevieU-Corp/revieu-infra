# Cloudflare API Token Secret Template
# Used by cert-manager for DNS01 challenge
#
# Usage:
# 1. Copy this template and replace <YOUR_CLOUDFLARE_API_TOKEN>
# 2. Encrypt with kubeseal:
#    kubeseal --format yaml --cert k8s/sealed-secrets-prod.pem \
#      < cloudflare-api-token-secret.yaml \
#      > ../apps/overlays/prod/common/cloudflare-api-token-sealed.yaml
# 3. Commit the sealed secret to git
#
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
stringData:
  api-token: <YOUR_CLOUDFLARE_API_TOKEN>

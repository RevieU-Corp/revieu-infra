# GitHub Container Registry Secret Template
# Used to pull images from ghcr.io
#
# Usage:
# 1. Create GitHub Personal Access Token with read:packages scope at:
#    https://github.com/settings/tokens/new?scopes=read:packages
# 2. Copy this template and fill in:
#    - <YOUR_GITHUB_USERNAME>: Your GitHub username
#    - <YOUR_GITHUB_TOKEN>: The PAT you just created
# 3. Encrypt with kubeseal for each environment:
#
#    # For prod:
#    kubeseal --format yaml --cert k8s/sealed-secrets-prod.pem \
#      --namespace revieu-prod \
#      < ghcr-credentials-secret.yaml \
#      > ../apps/overlays/prod/common/ghcr-credentials-sealed.yaml
#
#    # For staging:
#    kubeseal --format yaml --cert k8s/sealed-secrets-staging.pem \
#      --namespace revieu-staging \
#      < ghcr-credentials-secret.yaml \
#      > ../apps/overlays/staging/common/ghcr-credentials-sealed.yaml
#
#    # For dev:
#    kubeseal --format yaml --cert k8s/sealed-secrets-dev.pem \
#      --namespace revieu-dev \
#      < ghcr-credentials-secret.yaml \
#      > ../apps/overlays/dev/common/ghcr-credentials-sealed.yaml
#
# 4. Commit the sealed secrets to git
# 5. Reference in deployment:
#    spec:
#      imagePullSecrets:
#        - name: ghcr-credentials
#
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-credentials
  namespace: revieu-prod  # Change for each environment
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "ghcr.io": {
          "username": "<YOUR_GITHUB_USERNAME>",
          "password": "<YOUR_GITHUB_TOKEN>",
          "auth": "$(echo -n '<YOUR_GITHUB_USERNAME>:<YOUR_GITHUB_TOKEN>' | base64)"
        }
      }
    }
